# Writes OUT (a C file) with the commit the build is made from and when it was built, for the
# editor's Help > Version window. Run at every build (cmake -P); the file is rewritten only when
# the commit or its "changed" state is different, so an unchanged tree relinks nothing. The
# date is therefore when this commit was first built here (in CI: the build itself).
#   cmake -DSRC=<repository> -DOUT=<file.c> -P version.cmake
find_package(Git QUIET)
set(commit "unknown")
set(changed 0)
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SRC} rev-parse --short=12 HEAD
    OUTPUT_VARIABLE out RESULT_VARIABLE r OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(r EQUAL 0)
    set(commit "${out}")
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SRC} diff --quiet HEAD RESULT_VARIABLE dirty ERROR_QUIET)
    if(NOT dirty EQUAL 0)
      set(changed 1)
    endif()
  endif()
endif()
# A CI build of the pages names the commit itself.
if(DEFINED ENV{GITHUB_SHA})
  string(SUBSTRING "$ENV{GITHUB_SHA}" 0 12 commit)
  set(changed 0)
endif()
set(key "${commit} ${changed}")
if(EXISTS ${OUT})
  file(STRINGS ${OUT} old REGEX "^// key: ")
  if(old STREQUAL "// key: ${key}")
    return()
  endif()
endif()
string(TIMESTAMP date "%Y-%m-%d %H:%M UTC" UTC)
file(WRITE ${OUT} "// Generated by cmake/version.cmake; do not edit.
// key: ${key}
const char *const bm_build_commit = \"${commit}\";
const int bm_build_changed = ${changed};
const char *const bm_build_date = \"${date}\";
")
