<?xml version="1.0" encoding="UTF-8"?>
<sprite version="1" image="player.png">
 <hitbox x="-5" y="-30" w="10" h="30"/>
 <frame x="0" y="0" w="16" h="32" ax="8" ay="32"/>
 <frame x="16" y="0" w="16" h="32" ax="8" ay="32"/>
 <frame x="32" y="0" w="16" h="32" ax="8" ay="32"/>
 <frame x="48" y="0" w="16" h="32" ax="8" ay="32"/>
 <frame x="64" y="0" w="16" h="32" ax="8" ay="32"/>
 <frame x="80" y="0" w="16" h="32" ax="8" ay="32"/>
 <frame x="96" y="0" w="16" h="32" ax="8" ay="32"/>
 <frame x="112" y="0" w="16" h="32" ax="8" ay="32"/>
 <frame x="0" y="32" w="16" h="32" ax="8" ay="32"/>
 <frame x="16" y="32" w="16" h="32" ax="8" ay="32"/>
 <animation name="idle" loop="1">
  <step frame="0" duration="40"/>
  <step frame="1" duration="40"/>
 </animation>
 <animation name="run" loop="1">
  <step frame="2" duration="6"/>
  <step frame="3" duration="6"/>
  <step frame="4" duration="6"/>
  <step frame="5" duration="6"/>
 </animation>
 <animation name="jump" loop="0">
  <step frame="6" duration="1"/>
 </animation>
 <animation name="fall" loop="0">
  <step frame="7" duration="1"/>
 </animation>
 <animation name="climb" loop="1">
  <step frame="8" duration="10"/>
  <step frame="9" duration="10"/>
 </animation>
</sprite>
