# The save game's layouts of earlier versions (docs/spec/state.md §7): a save written by one
# of them is loaded by copying its fields by name into today's layout. `bmschema --add` adds
# the layout of the engine it is built with. A field renamed since: `rename old new`.
schema 0x27189968 "milestone-gba-hardware"
 game.roomIndex u32 1
 game.player.x fix 1
 game.player.y fix 1
 game.player.facing s8 1
 game.player.safeX s32 1
 game.player.safeY s32 1
 game.deaths u32 1
 game.roomChanges u32 1
 game.hurts u32 1
 game.saves u32 1
 game.actors.storeCount u8 1
 game.actors.storeKey u32 16
 game.actors.storeValue s32 16
 game.actors.itemCount u8 1
 game.actors.items u32 4
end
