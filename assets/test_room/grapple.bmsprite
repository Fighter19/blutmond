<?xml version="1.0" encoding="UTF-8"?>
<sprite version="1" image="grapple.png">
 <hitbox x="-4" y="-4" w="8" h="8"/>
 <frame x="0" y="0" w="8" h="8" ax="4" ay="4"/>
 <frame x="8" y="0" w="8" h="8" ax="4" ay="4"/>
 <frame x="16" y="0" w="16" h="16" ax="8" ay="8"/>
 <frame x="32" y="0" w="16" h="16" ax="8" ay="8"/>
 <animation name="hook" loop="1">
  <step frame="0" duration="60"/>
 </animation>
 <animation name="link" loop="1">
  <step frame="1" duration="60"/>
 </animation>
 <animation name="anchor" loop="1">
  <step frame="2" duration="50"/>
  <step frame="3" duration="10"/>
 </animation>
</sprite>
