# Kinds of enemies (structure Enemy in enemies.ms).
table Enemy

record Bat {
  damage = 1
  speed = 0.75
  wake_distance = 64
  drop = Potion
  drop_chance = 50
  weak = Holy
  hit_sound = "hit_bat"
}

# A faster bat that hits harder. Set Kind = FastBat on a bat in Tiled to use it.
record FastBat : Bat {
  damage = 2
  speed = 1.25
  give_up_distance = 160
}
