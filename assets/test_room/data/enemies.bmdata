# Kinds of enemies (structure Enemy in enemies.ms).
table Enemy

record Bat {
  behaviour = Bat
  damage = 1
  speed = 0.75
  wake_distance = 64
  drop = Potion
  drop_chance = 50
  weak = Holy
  hit_sound = "hit_bat"
}

# A faster bat that hits harder. Set Kind = FastBat on a bat in Tiled to use it.
record FastBat : Bat {
  damage = 2
  speed = 1.25
  give_up_distance = 160
}

# The Fast Bat in armour (layered-sprites.md §5): a room object with kind = IronBat is a Bat
# drawn red, with the armour on, and takes three times the strikes. No class, no sprite of its
# own: the armour is one more sheet drawn over the bat's frames.
record IronBat : FastBat {
  palette = #red
  extra = "bat_armour"
  health = 12
  speed = 1.0
}

# A knight with a shield (scripts/knight.ms): it blocks from the front and turns after
# patience x 8 frames; give_up_distance is how far it leaves the place it stands.
record Knight {
  damage = 2
  health = 9
  speed = 0.5
  wake_distance = 96
  give_up_distance = 64
  patience = 5
  drop = Potion
  drop_chance = 50
  hit_sound = "hit_dummy"
}
