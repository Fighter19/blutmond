  anim = #Overhead
}

record Whirlwind {
  title = "Whirlwind"
  keys = "Back, Down-Back, Down, Down-Fwd, Fwd + B"
  description = "The axe spins: four strikes all around."
  input = #Back_DownBack_Down_DownFwd_Fwd_Attack
