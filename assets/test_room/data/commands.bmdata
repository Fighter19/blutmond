# Charms
record BloodAbsorb {
  title = "Blood Absorb"
  keys = "Up, Down + R"
  description = "Draws blood from all around and heals with it."
  input = #Up_Down_Spell
  cost = 6
  charm = CrimsonCharm
  behaviour = CommandAbsorb
  frames = 80
}

record GravityFlip {
  title = "Gravity Flip"
  keys = "Down, Up + A"
  description = "Up becomes down: walk on the ceiling. Again to turn it back."
  input = #Down_Up_Jump
  cost = 3
  charm = MoonCharm
  behaviour = CommandGravity
  frames = 2
}
