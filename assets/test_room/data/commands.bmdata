# Commands: special moves (src/world/commands.h). Every weapon has its list, working while it is
# equipped; a charm's work while the charm is worn, with any weapon. A weapon's moves are
# CommandStrike with their numbers (the Command structure in data/items.ms).
table Command

# Short Sword
record Lunge {
  title = "Lunge"
  keys = "Down, Down-Fwd, Fwd + B"
  description = "A dash forward, blade first: twice the weapon's strength."
  input = #Down_DownFwd_Fwd_Attack
  cost = 4
  weapon = ShortSword
  frames = 24
  power = 200
  reach = 24
  dash = 5.0
}

record RisingSlash {
  title = "Rising Slash"
  keys = "Fwd, Down, Down-Fwd + B"
  description = "Two cuts on the way up."
  input = #Fwd_Down_DownFwd_Attack
  cost = 5
  weapon = ShortSword
  frames = 24
  power = 150
  hits = 2
  every = 6
  hop = 4.5
}

# Flame Brand: the sword's moves, burning, and one of its own.
record FlameLunge : Lunge {
  weapon = FlameBrand
  element = Fire
}

record FlameRisingSlash : RisingSlash {
  weapon = FlameBrand
  element = Fire
}

record FlameBurst {
  title = "Flame Burst"
  keys = "Down, Down + B"
  description = "Fire all around, three times."
  input = #Down_Down_Attack
  cost = 6
  weapon = FlameBrand
  frames = 30
  power = 120
  reach = -36
  hits = 3
  element = Fire
}

# Dagger
record Flurry {
  title = "Flurry"
  keys = "Fwd, Fwd + B"
  description = "Three quick stabs."
  input = #Fwd_Fwd_Attack
  cost = 2
  weapon = Dagger
  frames = 30
  reach = 16
  hits = 3
}

record SlipStab {
  title = "Slip Stab"
  keys = "Back, Fwd + B"
  description = "A hop back, then a stab where you were."
  input = #Back_Fwd_Attack
  cost = 3
  weapon = Dagger
  frames = 24
  power = 150
  reach = 40
  startup = 10
  dash = -2.0
  hop = 2.0
}

# Lance
record Charge {
  title = "Charge"
  keys = "Back, Fwd + B"
  description = "A run forward behind the point."
  input = #Back_Fwd_Attack
  cost = 4
  weapon = Lance
  frames = 24
  power = 180
  reach = 40
  dash = 5.0
  anim = #thrust
}

record SkyThrust {
  title = "Sky Thrust"
  keys = "Down, Up + B"
  description = "A leap with the point up, twice."
  input = #Down_Up_Attack
  cost = 5
  weapon = Lance
  frames = 30
  reach = 36
  hits = 2
  hop = 5.0
  anim = #thrust_up
}

