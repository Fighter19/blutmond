# German texts of the test level. Each line: "original" = "translation".
language de "Deutsch"

# Weapons
"Short Sword" = "Kurzschwert"
"A plain blade. The weapon everyone starts with." = "Eine schlichte Klinge. Damit fängt jeder an."
"Dagger" = "Dolch"
"Short and quick." = "Kurz und schnell."
"Great Axe" = "Große Axt"
"Slow and heavy; strikes from above as well." = "Langsam und schwer; trifft auch von oben."
"Chain Whip" = "Kettenpeitsche"
"Reaches far, a little late." = "Reicht weit, etwas spät."
"Throwing Knives" = "Wurfmesser"
"Two in the air at most." = "Höchstens zwei in der Luft."
"Flame Brand" = "Flammenklinge"
"A short sword that burns what it strikes." = "Ein Kurzschwert, das verbrennt, was es trifft."

# Spells
"Ember" = "Glut"
"A bolt of fire." = "Ein Feuergeschoss."
"Frost Shard" = "Frostsplitter"
"A bolt of ice that freezes what it strikes." = "Ein Eisgeschoss, das einfriert, was es trifft."
"Ward" = "Schutz"
"Halves the harm taken for a while." = "Halbiert eine Weile lang den erlittenen Schaden."
"Mend" = "Heilung"
"Heals over a short time." = "Heilt in kurzer Zeit."
"Blood Moon" = "Blutmond"
"Strikes everything around." = "Trifft alles ringsum."

# Abilities
"Double Jump" = "Doppelsprung"
"One more jump in the air." = "Ein weiterer Sprung in der Luft."
"Dash" = "Sprint"
"R: a quick dash." = "R: ein schneller Sprint."
"Wall Jump" = "Wandsprung"
"Slide down walls and jump off them." = "An Wänden hinabgleiten und von ihnen abspringen."
"Ground Pound" = "Stampfer"
"Down and B in the air: strike the ground." = "Unten und B in der Luft: auf den Boden schlagen."
"Second Wind" = "Zweiter Atem"
"Once in every room, a blow that would end you leaves you standing." = "Einmal in jedem Raum lässt dich ein tödlicher Schlag noch stehen."

# Consumables
"Potion" = "Trank"
"Restores 15 health." = "Stellt 15 Leben wieder her."
"Large Potion" = "Großer Trank"
"Restores 40 health." = "Stellt 40 Leben wieder her."
"Mana Vial" = "Manaphiole"
"Restores 15 mana." = "Stellt 15 Mana wieder her."
"Antidote" = "Gegengift"
"Cures poison." = "Heilt Vergiftung."
"Fire Flask" = "Feuerflasche"
"Thrown in an arc; burns where it lands." = "Im Bogen geworfen; brennt, wo sie landet."
"Return Feather" = "Rückkehrfeder"
"Back to the last save point." = "Zurück zum letzten Speicherpunkt."

# Armour
"Leather Cap" = "Lederkappe"
"Iron Helm" = "Eisenhelm"
"Traveller's Coat" = "Reisemantel"
"What everyone starts with." = "Damit fängt jeder an."
"Chain Mail" = "Kettenhemd"
"Strong, and a little slow." = "Stark und etwas langsam."
"Ember Cloak" = "Glutumhang"
"Fire does half the harm." = "Feuer richtet nur halben Schaden an."
"Lucky Coin" = "Glücksmünze"
"Blood Ring" = "Blutring"
"More strength, less life." = "Mehr Kraft, weniger Leben."
"Thorn Band" = "Dornenreif"
"What strikes you is struck back." = "Wer dich trifft, wird zurückgetroffen."

# Key items
"Coin" = "Münze"
"A gold coin." = "Eine Goldmünze."
"Key" = "Schlüssel"
"Opens a door somewhere." = "Öffnet irgendwo eine Tür."
