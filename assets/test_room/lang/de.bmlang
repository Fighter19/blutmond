"Equipment" = "Ausrüstung"
"Items" = "Gegenstände"
"Map" = "Karte"
"System" = "System"
"Close" = "Schließen"
"Health" = "Leben"
"Attack" = "Angriff"
"Defence" = "Abwehr"
