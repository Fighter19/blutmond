# The kinds of the snowman's fight's things (structure Thing in things.ms; frost.ms).
table Thing

# (Lives are short: the park has 4 places for the fight's things, its own objects the others:
# two pillars, two icicles or the beam's two parts, a snowball or two.)
record FrostBall {
  does = Roll
  dx = 16
  speed = 1.6
  life = 240
  damage = 2
}

# The ripple his stomp sends through the ground, to where Mitsuki stood: there a pillar of ice
# breaks out, a block of ice, and stands (frost.ms STANDS; life: at most, its way and that).
record FrostRipple {
  does = Ripple
  speed = 2.8
  life = 560
  damage = 2
}

# (Gone after 250 pixels, about a screen: two at most in the air, snowman.ms Icicles.)
record FrostIcicle {
  does = Icicle
  dx = 22
  dy = -6
  speed = 4.5
  life = 56
  damage = 2
}

# The frost beam: from his mouth (grown: 50 pixels up), first at the ground just before his
# feet (40: some 56 degrees down), sweeping out and up to 6 (some 8 degrees down: the ground
# 300 pixels away) over its life.
record FrostBeam {
  does = Beam
  dx = 6
  dy = -50
  life = 84
  damage = 3
  reach = 340
  aim_from = 40
  aim_to = 6
}

record FrostShade {
  does = Shade
  dy = -30
  life = 200
  damage = 0
}
