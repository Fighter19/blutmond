<?xml version="1.0" encoding="UTF-8"?>
<!-- The snowman (snowman.py, snowman.ms): small (still, holding on, happy), the boss (standing,
     throwing, in a jump, his frost breath); then the fight's things (frost.ms): the snowball, the
     ripple, the block of ice (rising, standing), an icicle, the shadow. Hit boxes around their
     materials: snow (his stomp: the jump frame), ice (ripple, rising block, icicle), dust (the
     snowball). (His frost beam is no sprite: set_beam.) -->
<sprite version="1" image="snowman.png">
 <hitbox x="-10" y="-42" w="20" h="42"/>
 <frame x="0" y="0" w="32" h="48" ax="16" ay="46"/>
 <frame x="0" y="0" w="32" h="48" ax="16" ay="46"/>
 <frame x="0" y="0" w="32" h="48" ax="16" ay="46"/>
 <frame x="0" y="0" w="56" h="56" ax="28" ay="54">
   <box kind="hurt" x="-8" y="-37" w="16" h="37"/>
 </frame>
 <frame x="0" y="0" w="56" h="56" ax="28" ay="54">
   <box kind="hurt" x="-8" y="-37" w="16" h="37"/>
 </frame>
 <frame x="0" y="0" w="56" h="56" ax="28" ay="54">
   <box kind="hurt" x="-8" y="-37" w="16" h="37"/>
   <box kind="hit" name="snow" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="56" h="56" ax="28" ay="54">
   <box kind="hurt" x="-8" y="-37" w="16" h="37"/>
 </frame>
 <frame x="0" y="0" w="16" h="16" ax="8" ay="14">
   <box kind="hit" name="dust" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="16" h="16" ax="8" ay="14">
   <box kind="hit" name="dust" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="24" h="16" ax="12" ay="14">
   <box kind="hit" name="ice" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="24" h="16" ax="12" ay="14">
   <box kind="hit" name="ice" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="32" h="32" ax="16" ay="30">
   <box kind="hit" name="ice" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="32" h="56" ax="16" ay="54"/>
 <frame x="0" y="0" w="24" h="16" ax="12" ay="14">
   <box kind="hit" name="ice" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="20" h="32" ax="10" ay="30"/>
 <frame x="0" y="0" w="20" h="32" ax="10" ay="30"/>
 <!-- 16 on: his frames 0 to 6 without the ball (snowman_sheet.py: what is behind it; dropped) -->
 <frame x="0" y="0" w="32" h="48" ax="16" ay="46"/>
 <frame x="0" y="0" w="32" h="48" ax="16" ay="46"/>
 <frame x="0" y="0" w="32" h="48" ax="16" ay="46"/>
 <frame x="0" y="0" w="56" h="56" ax="28" ay="54"/>
 <frame x="0" y="0" w="56" h="56" ax="28" ay="54"/>
 <frame x="0" y="0" w="56" h="56" ax="28" ay="54"/>
 <frame x="0" y="0" w="56" h="56" ax="28" ay="54"/>
 <animation name="still" loop="1">
  <step frame="0" duration="60"/>
 </animation>
 <animation name="hold" loop="1">
  <step frame="1" duration="60"/>
 </animation>
 <animation name="happy" loop="1">
  <step frame="2" duration="60"/>
 </animation>
 <animation name="grow" loop="0">
  <step frame="1" duration="10"/>
  <step frame="3" duration="10"/>
  <step frame="1" duration="8"/>
  <step frame="3" duration="8"/>
  <step frame="1" duration="6"/>
  <step frame="3" duration="60"/>
 </animation>
 <animation name="idle" loop="1">
  <step frame="3" duration="60"/>
 </animation>
 <animation name="throw" loop="1">
  <step frame="4" duration="60"/>
 </animation>
 <animation name="jump" loop="1">
  <step frame="5" duration="60"/>
 </animation>
 <animation name="land" loop="1">
  <step frame="3" duration="60"/>
 </animation>
 <animation name="breath" loop="1">
  <step frame="6" duration="60"/>
 </animation>
 <animation name="roll" loop="1">
  <step frame="7" duration="6"/>
  <step frame="8" duration="6"/>
 </animation>
 <animation name="ripple" loop="1">
  <step frame="9" duration="4"/>
  <step frame="10" duration="4"/>
 </animation>
 <animation name="rise" loop="0">
  <step frame="11" duration="6"/>
  <step frame="12" duration="60"/>
 </animation>
 <animation name="block" loop="1">
  <step frame="12" duration="60"/>
 </animation>
 <animation name="icicle" loop="1">
  <step frame="13" duration="60"/>
 </animation>
 <animation name="shade" loop="1">
  <step frame="14" duration="8"/>
  <step frame="15" duration="8"/>
 </animation>
</sprite>
