<?xml version="1.0" encoding="UTF-8"?>
<!-- The snowman (snowman.py, snowman.ms): still, holding on, the boss (standing, throwing, a
     stomp, the frost breath), happy; then the fight's things: the snowball, ice shards, the frost
     breath, a block of ice, the shadow (their hit boxes ice, frost: around those materials). -->
<sprite version="1" image="snowman.png">
 <hitbox x="-10" y="-42" w="20" h="42"/>
 <frame x="0" y="0" w="28" h="40" ax="14" ay="38"/>
 <frame x="0" y="0" w="28" h="40" ax="14" ay="38"/>
 <frame x="0" y="0" w="40" h="52" ax="20" ay="50"/>
 <frame x="0" y="0" w="40" h="52" ax="20" ay="50"/>
 <frame x="0" y="0" w="40" h="52" ax="20" ay="50"/>
 <frame x="0" y="0" w="40" h="52" ax="20" ay="50"/>
 <frame x="0" y="0" w="28" h="40" ax="14" ay="38"/>
 <frame x="0" y="0" w="16" h="16" ax="8" ay="14">
  <box kind="hit" name="ice" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="16" h="16" ax="8" ay="14">
  <box kind="hit" name="ice" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="20" h="16" ax="10" ay="14">
  <box kind="hit" name="ice" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="20" h="24" ax="10" ay="22">
  <box kind="hit" name="ice" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="24" h="16" ax="12" ay="14">
  <box kind="hit" name="frost" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="24" h="16" ax="12" ay="14">
  <box kind="hit" name="frost" x="0" y="0" w="1" h="1"/>
 </frame>
 <frame x="0" y="0" w="16" h="40" ax="8" ay="38"/>
 <frame x="0" y="0" w="16" h="28" ax="8" ay="26"/>
 <frame x="0" y="0" w="16" h="28" ax="8" ay="26"/>
 <animation name="still" loop="1">
  <step frame="0" duration="60"/>
 </animation>
 <animation name="hold" loop="1">
  <step frame="1" duration="60"/>
 </animation>
 <animation name="grow" loop="0">
  <step frame="1" duration="10"/>
  <step frame="2" duration="10"/>
  <step frame="1" duration="8"/>
  <step frame="2" duration="8"/>
  <step frame="1" duration="6"/>
  <step frame="2" duration="60"/>
 </animation>
 <animation name="idle" loop="1">
  <step frame="2" duration="60"/>
 </animation>
 <animation name="throw" loop="1">
  <step frame="3" duration="60"/>
 </animation>
 <animation name="jump" loop="1">
  <step frame="4" duration="60"/>
 </animation>
 <animation name="land" loop="1">
  <step frame="2" duration="60"/>
 </animation>
 <animation name="breath" loop="1">
  <step frame="5" duration="60"/>
 </animation>
 <animation name="happy" loop="1">
  <step frame="6" duration="60"/>
 </animation>
 <animation name="roll" loop="1">
  <step frame="7" duration="6"/>
  <step frame="8" duration="6"/>
 </animation>
 <animation name="shard" loop="0">
  <step frame="9" duration="6"/>
  <step frame="10" duration="60"/>
 </animation>
 <animation name="frost" loop="1">
  <step frame="11" duration="4"/>
  <step frame="12" duration="4"/>
 </animation>
 <animation name="block" loop="1">
  <step frame="13" duration="60"/>
 </animation>
 <animation name="shade" loop="1">
  <step frame="14" duration="8"/>
  <step frame="15" duration="8"/>
 </animation>
</sprite>
