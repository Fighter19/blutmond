<?xml version="1.0" encoding="UTF-8"?>
<!-- The nightmare (nightmare.py): rising, hushing, reaching
     (as holding: frame 2 is empty), holding, leaping. -->
<sprite version="1" image="nightmare.png">
 <hitbox x="-8" y="-48" w="16" h="48"/>
 <frame x="0" y="0" w="40" h="64" ax="20" ay="60"><point name="hand" x="0" y="0"/></frame>
 <frame x="0" y="0" w="40" h="64" ax="20" ay="60"><point name="hand" x="0" y="0"/></frame>
 <frame x="0" y="0" w="48" h="64" ax="20" ay="60"><point name="hand" x="0" y="0"/></frame>
 <frame x="0" y="0" w="48" h="64" ax="20" ay="60"><point name="hand" x="0" y="0"/></frame>
 <frame x="0" y="0" w="56" h="64" ax="24" ay="60"><point name="hand" x="0" y="0"/></frame>
 <animation name="rise" loop="0">
  <step frame="0" duration="1"/>
 </animation>
 <animation name="hush" loop="1">
  <step frame="1" duration="60"/>
 </animation>
 <animation name="reach" loop="0">
  <step frame="3" duration="1"/>
 </animation>
 <animation name="hold" loop="1">
  <step frame="3" duration="60"/>
 </animation>
 <animation name="leap" loop="1">
  <step frame="4" duration="60"/>
 </animation>
</sprite>
