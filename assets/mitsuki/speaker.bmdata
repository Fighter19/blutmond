# Mitsuki in the dialogue box (structure Speaker in assets/test_room/data/dialogue.ms): her
# name, portrait and voice (voice_mitsuki.bmsong, tools/make_test_songs.py) for the player's
# lines while she is the player (characters.bmdata).
table Speaker

record Mitsuki {
  name = "Mitsuki"
  portrait = "mitsuki_face"
  voice = "voice_mitsuki"
}
