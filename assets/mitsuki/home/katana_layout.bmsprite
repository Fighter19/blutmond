<?xml version="1.0" encoding="UTF-8"?>
<!-- The katana on its rack (katana.py): one frame. The hitbox reaches down to the floor, so
     walking under the rack takes it. -->
<sprite version="1" image="katana.png">
 <hitbox x="-16" y="-6" w="32" h="44"/>
 <frame x="0" y="0" w="36" h="12" ax="18" ay="6"/>
 <animation name="rest" loop="1">
  <step frame="0" duration="60"/>
 </animation>
</sprite>
